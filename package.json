    "@earendil-works/pi-tui": "^0.80.3",
    "@types/node": "^25.9.1",
    "typebox": "^1.1.38",
    "typescript": "^6.0.3"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.3",
